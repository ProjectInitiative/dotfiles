#!/bin/sh
# dli-outlet — control a Digital Loggers EPCR6 outlet for kvmd's cmd/cmdret
# GPIO pseudo-drivers on PiKVM.
#
# Usage: dli-outlet <outlet-number> <on|off|cycle|state>
#
# Auth: the non-admin `pikvm` user over HTTP DIGEST. Requirements on the
# unit (all configured 2026-11-23):
#   - Setup > Users: `pikvm` granted outlets 5-8
#   - Setup > External APIs: "Allow REST-style API" +
#     "Allow REST-style API for non-admin users" enabled
# NOTE: DLI client access tokens (bearer) are NOT supported by the EPCR6
# (wired-only firmware routes bearer/Basic/client auth through the user
# login path and fails with "no such user"); see README for the full saga.
# Digest everywhere: the unit denies plaintext logins by default.
#
# Control + state use the REST API exclusively — the legacy outlet?N=
# interface does not exist on the "Power Controller" firmware (requests
# silently no-op with a redirect page). REST indexes are ZERO-BASED
# (docs: "the outlet index is zero-based"), so index = outlet - 1; the
# DLI UI and our cmd lists are 1-based. Wrong indexing silently controls
# the adjacent outlet.
#
# Cycle uses the unit's native POST /cycle/ endpoint (its own timed
# cycle), not an off/sleep/on emulation.

set -eu

DLI_HOST="${DLI_HOST:-http://172.16.1.4}"
DLI_USER="${DLI_USER:-pikvm}"
# Password from the environment only (DLI_PASS). The kvmd service gets it
# via a root-owned systemd EnvironmentFile — never inline it here; this
# script is committed to a public repo.
if [ -z "${DLI_PASS:-}" ]; then
    echo "dli-outlet: DLI_PASS is not set" >&2
    exit 2
fi

CURL="/usr/bin/curl"
CURL_OPTS="-m 8 -sf --digest"
AUTH=(-u "$DLI_USER:$DLI_PASS")

OUTLET="$1"
ACTION="$2"
INDEX=$((OUTLET - 1))

# ---- state ----------------------------------------------------------------

# GET /restapi/relay/outlets/<index>/state/ -> "true"/"false"
# 403 "Security lockout in place" = DLI brute-force lockout of our IP
# (triggered by the bearer-token debug 401s). Wait it out; do not retry
# aggressively or the window extends.
dli_state() {
    state=$($CURL $CURL_OPTS "${AUTH[@]}" -H 'Accept: application/json' \
        "$DLI_HOST/restapi/relay/outlets/$INDEX/state/" 2>/dev/null) || return 1
    [ "$state" = "true" ]
}

# ---- control ---------------------------------------------------------------

rest_set() {
    # rest_set <rest-index> <true|false>
    $CURL $CURL_OPTS "${AUTH[@]}" -X PUT -H 'X-CSRF: x' -H 'Accept: application/json' \
        --data "value=$2" \
        "$DLI_HOST/restapi/relay/outlets/$1/state/" || {
        echo "dli-outlet: control failed (HTTP error; if 403 'Security lockout', wait for the unit's lockout window to expire)" >&2
        exit 3
    }
}

rest_cycle() {
    # rest_cycle <rest-index>
    $CURL $CURL_OPTS "${AUTH[@]}" -X POST -H 'X-CSRF: x' -H 'Accept: application/json' \
        "$DLI_HOST/restapi/relay/outlets/$1/cycle/" || {
        echo "dli-outlet: cycle failed (HTTP error; if 403 'Security lockout', wait for the unit's lockout window to expire)" >&2
        exit 3
    }
}

case "$ACTION" in
on)
    rest_set "$INDEX" true >/dev/null
    ;;
off)
    rest_set "$INDEX" false >/dev/null
    ;;
cycle)
    rest_cycle "$INDEX" >/dev/null
    ;;
state)
    dli_state
    ;;
*)
    echo "usage: dli-outlet <outlet-number> <on|off|cycle|state>" >&2
    exit 2
    ;;
esac
