#!/bin/sh
# dli-outlet — control a Digital Loggers EPCR6 outlet for kvmd's cmd/cmdret
# GPIO pseudo-drivers on PiKVM.
#
# Usage: dli-outlet <outlet-number> <on|off|cycle|state>
#
# Control uses the REST API (PUT /restapi/relay/outlets/N;/state/) — this
# unit's "Power Controller" firmware does NOT implement the legacy
# outlet?N=ON|OFF|CCL interface (requests silently no-op with a redirect
# page). REST requires an ADMIN account (non-admin gets 403), so
# DLI_USER/DLI_PASS in the env file must be admin creds. Cycle is
# implemented as off -> wait -> on (DLI_CYCLE_DELAY, default 10s). State
# uses the REST API with a legacy /status bitmap fallback for older
# firmware. Exit 0 = outlet is ON / command accepted; exit 1 = off /
# failure.
#
# Unit settings required: Setup > External APIs > "Allow REST-style API"
# enabled. PUTs carry an X-CSRF header (per DLI REST reference) so no CSRF
# relaxation setting is needed.
#
# Digest auth everywhere: plaintext (Basic) logins are explicitly denied
# by the unit (DLI log: "login denied ... (plaintext)").

set -eu

DLI_HOST="${DLI_HOST:-http://172.16.1.4}"
DLI_USER="${DLI_USER:-pikvm}"
# Password comes from the environment only (DLI_PASS). The kvmd service
# gets it via a root-owned systemd EnvironmentFile — never inline it here;
# this script is committed to a public repo.
if [ -z "${DLI_PASS:-}" ]; then
    echo "dli-outlet: DLI_PASS is not set" >&2
    exit 2
fi
# All requests use digest auth: this unit has plaintext (Basic) logins
# explicitly disabled — basic-auth requests are silently denied with a 200
# redirect page, which makes failures look like successes (DLI log:
# "login denied ... (plaintext): explicit plaintext login denied").
CURL="/usr/bin/curl"
CURL_OPTS="-m 8 -sf --digest"

OUTLET="$1"
ACTION="$2"

# REST indexes are ZERO-BASED (per EPCR6 docs: uom keys relay/outlets/ ->
# [0..7]; "The outlet index is zero-based"). The DLI web UI numbers outlets
# 1-based, as do our cmd lists — so index = outlet - 1. Getting this wrong
# silently controls the adjacent outlet.
INDEX=$((OUTLET - 1))

# ---- state ----------------------------------------------------------------

# REST: /restapi/relay/outlets/<index>;/state/ -> "true"/"false" (admin only).
# Legacy: /status HTML embeds a hex outlet bitmap, one char per nibble,
# e.g. 0x2E1 -> outlets 1,6,10 on (bit N-1 of the number).
dli_state() {
    rest=$($CURL $CURL_OPTS --digest -u "$DLI_USER:$DLI_PASS" \
        -H 'Accept: application/json' \
        "$DLI_HOST/restapi/relay/outlets/$INDEX;/state/" 2>/dev/null) && {
        [ "$rest" = "true" ]
        return
    }

    bitmap=$($CURL $CURL_OPTS -u "$DLI_USER:$DLI_PASS" "$DLI_HOST/status" 2>/dev/null \
        | grep -io 'state[^<]*0[xX][0-9a-fA-F]*' \
        | grep -io '0[xX][0-9a-fA-F]*' \
        | head -n 1) || true
    [ -n "$bitmap" ] || return 1

    bits=$(printf '%d' "$bitmap") || return 1
    mask=$((1 << (OUTLET - 1)))
    [ $((bits & mask)) -ne 0 ]
}

# ---- control (REST PUT; legacy GET fallback) -------------------------------

rest_set() {
    # rest_set <rest-index> <true|false>
    $CURL $CURL_OPTS -X PUT -H 'X-CSRF: x' -H 'Accept: application/json' \
        --data "value=$2" \
        "$DLI_HOST/restapi/relay/outlets/$1;/state/"
}

# ---- actions --------------------------------------------------------------

case "$ACTION" in
on)
    rest_set "$INDEX" true >/dev/null
    ;;
off)
    rest_set "$INDEX" false >/dev/null
    ;;
cycle)
    # REST has no CCL; do off -> wait -> on. 10s is a safe default for
    # mini-PC PSUs; override with DLI_CYCLE_DELAY in the env file.
    rest_set "$INDEX" false >/dev/null
    sleep "${DLI_CYCLE_DELAY:-10}"
    rest_set "$INDEX" true >/dev/null
    ;;
state)
    dli_state
    ;;
*)
    echo "usage: dli-outlet <outlet-number> <on|off|cycle|state>" >&2
    exit 2
    ;;
esac
