#!/bin/sh
# dli-outlet — control a Digital Loggers EPCR6 outlet for kvmd's cmd/cmdret
# GPIO pseudo-drivers on PiKVM.
#
# Usage: dli-outlet <outlet-number> <on|off|cycle|state>
#
# Auth: DLI client ACCESS TOKEN (bearer) — NOT a user password. The token
# is registered on the unit with scopes granting ONLY outlets 5-8
# (get/modify/invoke), so the PiKVM holds neither the admin password nor
# broad access. Registration is a one-time admin step (see README).
#
# Control + state use the REST API exclusively. This unit's "Power
# Controller" firmware does NOT implement the legacy outlet?N= interface
# (requests silently no-op with a redirect page), and REST-over-HTTP for
# *user* auth is admin-only — but bearer-token clients bypass that gate.
# REST indexes are ZERO-BASED (docs: "the outlet index is zero-based"),
# so index = outlet - 1; the DLI UI and our cmd lists are 1-based.
# Getting indexing wrong silently controls the adjacent outlet.
#
# Cycle uses the unit's native POST /cycle/ endpoint (its own timed
# cycle), not an off/sleep/on emulation.
#
# Digest auth everywhere: plaintext (Basic) logins are explicitly denied
# by the unit (DLI log: "login denied ... (plaintext)").

set -eu

DLI_HOST="${DLI_HOST:-http://172.16.1.4}"
DLI_CLIENT="${DLI_CLIENT:-pikvm}"
DLI_TOKEN="${DLI_TOKEN:-}"
if [ -z "$DLI_TOKEN" ]; then
    echo "dli-outlet: DLI_TOKEN is not set" >&2
    exit 2
fi

# All requests use digest + bearer header.
CURL="/usr/bin/curl"
CURL_OPTS="-m 8 -sf --digest"
AUTH="Authorization: Bearer $DLI_CLIENT.$DLI_TOKEN"

OUTLET="$1"
ACTION="$2"
INDEX=$((OUTLET - 1))

# ---- state ----------------------------------------------------------------

# GET /restapi/relay/outlets/<index>;/state/ -> "true"/"false"
dli_state() {
    state=$($CURL $CURL_OPTS -H "$AUTH" -H 'Accept: application/json' \
        "$DLI_HOST/restapi/relay/outlets/$INDEX;/state/" 2>/dev/null) || return 1
    [ "$state" = "true" ]
}

# ---- control ---------------------------------------------------------------

rest_set() {
    # rest_set <rest-index> <true|false>
    $CURL $CURL_OPTS -H "$AUTH" -X PUT -H 'X-CSRF: x' -H 'Accept: application/json' \
        --data "value=$2" \
        "$DLI_HOST/restapi/relay/outlets/$1;/state/"
}

rest_cycle() {
    # rest_cycle <rest-index>
    $CURL $CURL_OPTS -H "$AUTH" -X POST -H 'X-CSRF: x' -H 'Accept: application/json' \
        "$DLI_HOST/restapi/relay/outlets/$1;/cycle/"
}

case "$ACTION" in
on)
    rest_set "$INDEX" true >/dev/null
    ;;
off)
    rest_set "$INDEX" false >/dev/null
    ;;
cycle)
    rest_cycle "$INDEX" >/dev/null
    ;;
state)
    dli_state
    ;;
*)
    echo "usage: dli-outlet <outlet-number> <on|off|cycle|state>" >&2
    exit 2
    ;;
esac
