From: teo-casares <gist 8b64949638e1952602a7f435bb34d5b8>
Subject: [PATCH] surface_aggregator_registry: add MSHW0733 (Surface Laptop Ultra)

surface_aggregator_registry has no entry for the Surface Laptop Ultra
platform ID MSHW0733, so no SSAM client devices are registered. Adds the
platform entry with battery + AC only (the EC's HID devices are left out
so they cannot fight the I2C keyboard/touchpad). Stock
surface_battery/surface_charger then create BAT1/ADP1.

--- a/drivers/platform/surface/surface_aggregator_registry.c
+++ b/drivers/platform/surface/surface_aggregator_registry.c
@@ -302,6 +302,14 @@
 	NULL,
 };
 
+/* Devices for Surface Laptop Ultra (NVIDIA N1X, ACPI). Battery + AC only for now. */
+static const struct software_node *ssam_node_group_slu[] = {
+	&ssam_node_root,
+	&ssam_node_bat_ac,
+	&ssam_node_bat_main,
+	NULL,
+};
+
 /* Devices for Surface Laptop Studio 1. */
 static const struct software_node *ssam_node_group_sls1[] = {
 	&ssam_node_root,
@@ -502,6 +510,9 @@
 	/* Surface Laptop Studio 2 */
 	{ "MSHW0360", (unsigned long)ssam_node_group_sls2 },
 
+	/* Surface Laptop Ultra (NVIDIA N1X) */
+	{ "MSHW0733", (unsigned long)ssam_node_group_slu },
+
 	{ },
 };
 MODULE_DEVICE_TABLE(acpi, ssam_platform_hub_acpi_match);
