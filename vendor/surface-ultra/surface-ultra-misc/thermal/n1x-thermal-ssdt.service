[Unit]
Description=Surface Laptop Ultra (N1X) SoC Tj safety net (extra ACPI thermal zone)
DefaultDependencies=no
After=sys-kernel-config.mount
Before=n1x-thermald.service

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStartPre=/usr/bin/modprobe acpi_configfs
# Loads \_TZ.NXTJ (passive 100 C on all CPUs, critical 105 C). Skipped if already loaded;
# an ACPI table cannot be unloaded cleanly, so a reboot is the way to drop it.
ExecStart=/bin/sh -c 'd=/sys/kernel/config/acpi/table/n1xthrm; [ -e "$d" ] || { mkdir "$d" && cat /usr/local/lib/n1x-thermal/n1x-thermal.aml > "$d/aml"; }'

[Install]
WantedBy=sysinit.target
