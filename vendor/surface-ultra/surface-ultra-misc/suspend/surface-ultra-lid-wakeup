#!/bin/sh
# Surface Laptop Ultra: the I2C keyboard (MSHW0794), the touchpad (MSHW0734) and the power
# button (MSHW0040, n1x-power-button) wake the machine from s2idle while the lid is closed
# (e.g. in a bag). Disable their wakeup only for lid-closed suspends and restore it on
# resume (omarchy discussions #15885).
DEVS="/sys/bus/i2c/devices/i2c-MSHW0794:00 /sys/bus/i2c/devices/i2c-MSHW0734:00 /sys/bus/platform/devices/MSHW0040:00"

set_wakeup() {
	for d in $DEVS; do
		f=$d/power/wakeup
		[ -w "$f" ] && echo "$1" > "$f"
	done
}

case "$1" in
pre)
	grep -qs closed /proc/acpi/button/lid/*/state && set_wakeup disabled
	;;
post)
	set_wakeup enabled
	;;
esac
exit 0
