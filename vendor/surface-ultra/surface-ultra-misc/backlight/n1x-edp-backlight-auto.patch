 def millinits_to_pct(mn):
     return max(0, min(100, round(100 * math.sqrt(max(mn / 1000.0, 0) / MAX_NITS))))
 
+# Windows AdaptiveDisplayBrightness AutobrightnessLuxToNitsCurve for this machine (lux, nits)
+LUX_TO_NITS = [(0, 16), (2, 34), (5, 46), (10, 60), (20, 75), (40, 106), (100, 160), (400, 181),
+               (700, 240), (2000, 408), (3000, 510), (4500, 655), (7000, 850), (15000, 1000)]
+AUTO_TICK_S = 1.0
+AUTO_ALPHA = 0.3        # EWMA weight of a new lux sample
+AUTO_DEADBAND = 3       # % difference before following the light
+AUTO_STEP = 5           # % per tick at most
+
+def lux_to_nits(lux):
+    for (l0, n0), (l1, n1) in zip(LUX_TO_NITS, LUX_TO_NITS[1:]):
+        if lux <= l1:
+            return n0 + (n1 - n0) * max(lux - l0, 0) / (l1 - l0)
+    return LUX_TO_NITS[-1][1]
+
+def find_als():
+    for d in glob.glob("/sys/bus/iio/devices/iio:device*"):
+        try:
+            with open(d + "/name") as f:
+                if f.read().strip() == "als": return d
+        except OSError: pass
+    return None
+
+def read_lux(d):
+    with open(d + "/in_illuminance_raw") as f: raw = float(f.read())
+    with open(d + "/in_illuminance_scale") as f: scale = float(f.read())
+    return raw * scale
+
+def save_int(path, val):
+    try:
+        with open(path + ".tmp", "w") as f: f.write(str(val))
+        os.replace(path + ".tmp", path)
+    except OSError as e: log("could not save state:", e)
+
+def load_int(path, default):
+    try:
+        with open(path) as f: return int(f.read().strip())
+    except (OSError, ValueError): return default
+
+def auto_wanted():
+    try:
+        with open(AUTO) as f: return f.read().strip() != "0"
+    except OSError: return True
