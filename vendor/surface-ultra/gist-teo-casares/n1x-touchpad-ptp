#!/bin/bash
# Surface Laptop Ultra (N1X) ELAN touchpad 04F3:3358 is a Windows Precision Touchpad with a
# per-contact Confidence (palm) bit, but its PTPHQA blob is 4 bytes instead of 256, so hid-core
# groups it as generic multitouch and hid-multitouch never maps Confidence -> MT_TOOL_PALM.
# Rebind it with class MT_CLS_WIN_8 (0x12) via a dynamic id so libinput gets palm reports.
D=/sys/bus/hid/drivers/hid-multitouch
for _ in $(seq 50); do
  dev=$(basename "$(ls -d /sys/bus/hid/devices/0018:04F3:3358.* 2>/dev/null | head -1)")
  [ -n "$dev" ] && [ -e "$D/$dev" ] && break
  sleep 0.2
done
[ -e "$D/$dev" ] || { echo "touchpad not bound to hid-multitouch"; exit 1; }
# Already Win8 class? (ABS_MT_TOOL_TYPE = bit 55 on an input node)
for a in /sys/bus/hid/devices/$dev/input/input*/capabilities/abs; do
  (( (0x$(cat "$a") >> 55) & 1 )) 2>/dev/null && { echo "already PTP class"; exit 0; }
done
echo "18 04f3 3358 12" > $D/new_id
echo -n "$dev" > $D/unbind
echo -n "$dev" > $D/bind
echo "rebound $dev as MT_CLS_WIN_8"
