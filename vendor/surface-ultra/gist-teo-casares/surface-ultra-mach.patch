+/*
+ * Microsoft Surface Laptop Ultra (NVIDIA N1X): everything on SDW0.
+ * 2x RT1320 (uids 0x30/0x32) drive the speakers; RT1320 uid 0x30 also
+ * carries the internal microphone array on its DMIC function (ACPI
+ * \_SB.AUDC "MicrophoneArray" -> \_SB.CNT0.SPD0.AF02, SDCA terminal type
+ * 0x0205), exposed by rt1320-sdw as "rt1320-aif2" (sdw_utils dai 1).
+ * RT721 (uid 0x30) is the jack codec. The 0x0718 peripheral has no
+ * Linux codec driver and is left out (extra peripherals do not prevent
+ * a match).
+ */
+static const struct snd_soc_acpi_endpoint rt1320_spk_dmic_endpoints[] = {
+	{	/* aif1: speaker amp, left of the aggregated pair */
+		.num = 0,
+		.aggregated = 1,
+		.group_position = 0,
+		.group_id = 1,
+	},
+	{	/* aif2: DMIC (internal microphone array) */
+		.num = 1,
+		.aggregated = 0,
+		.group_position = 0,
+		.group_id = 0,
+	},
+};
+
+static const struct snd_soc_acpi_endpoint rt721_jack_endpoints[] = {
+	{	/* aif1: headset jack (playback + headset mic) */
+		.num = 0,
+		.aggregated = 0,
+		.group_position = 0,
+		.group_id = 0,
+	},
+};
+
+static const struct snd_soc_acpi_adr_device surface_ultra_l0_adr[] = {
+	{
+		.adr = 0x000030025D132001ull,
+		.num_endpoints = ARRAY_SIZE(rt1320_spk_dmic_endpoints),
+		.endpoints = rt1320_spk_dmic_endpoints,
+		.name_prefix = "rt1320-1",
+	},
+	{
+		.adr = 0x000032025D132001ull,
+		.num_endpoints = 1,
+		.endpoints = &rt1320_endpoints[1],
+		.name_prefix = "rt1320-2",
+	},
+	{
+		.adr = 0x000030025D072101ull,
+		.num_endpoints = ARRAY_SIZE(rt721_jack_endpoints),
+		.endpoints = rt721_jack_endpoints,
+		.name_prefix = "rt721",
+	},
+};
+
+static const struct snd_soc_acpi_link_adr mtk_sdw_rt1320x2_rt721_l0[] = {
+	{
+		.mask = BIT(0),
+		.num_adr = ARRAY_SIZE(surface_ultra_l0_adr),
+		.adr_d = surface_ultra_l0_adr,
+	},
+	{}
+};
+
 static struct snd_soc_acpi_mach mtk_sdw_machines[] = {
