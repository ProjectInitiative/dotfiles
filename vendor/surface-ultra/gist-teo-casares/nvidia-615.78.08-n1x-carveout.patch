+++ b/kernel-open/common/inc/nv-carveout-map.h	2026-10-18 12:43:49.367758915 -0400
@@ -0,0 +1,100 @@
+/*
+ * Kernel mappings of firmware carveout memory (NVIDIA N1x, Surface Laptop
+ * Ultra). The firmware leaves the GPU's display carveout out of the EFI memory
+ * map, so most of it has no struct page; the 48 MiB below 0x200000000 shares a
+ * memmap section with RAM and has reserved struct pages. vmap() rejects the
+ * former, so such allocations are mapped here instead.
+ *
+ * Plain kernel types only: also built into the n1x_pfn_probe test module.
+ */
+#ifndef __NV_CARVEOUT_MAP_H__
+#define __NV_CARVEOUT_MAP_H__
+
+#include <linux/mm.h>
+#include <linux/io.h>
+#include <linux/ioport.h>
+#include <linux/vmalloc.h>
+#include <linux/printk.h>
+#include <linux/memremap.h>
+
+/*
+ * A carveout page, to be mapped to user space by pfn (remap_pfn_range) rather
+ * than vm_insert_page(): no struct page; a ZONE_DEVICE one (the memmap that
+ * n1x_carveout_memmap gives the carveout); or a reserved one outside System
+ * RAM. Reserved RAM (the zero page, kernel image) is not one; page_is_ram()
+ * only runs for reserved pages.
+ */
+static inline bool nv_carveout_pfn(unsigned long pfn)
+{
+    struct page *page;
+
+    if (!pfn_valid(pfn))
+        return true;
+    page = pfn_to_page(pfn);
+    return is_zone_device_page(page) ||
+           (PageReserved(page) && !page_is_ram(pfn));
+}
+
+/*
+ * Kernel-map count pages, at least one without a struct page (the carveout
+ * when n1x_carveout_memmap is not loaded), with prot. Returns NULL, after
+ * logging the page list, when no mapping fits; free with vunmap(). With the
+ * memmap module loaded every page has a struct page and plain vmap() is used.
+ */
+static inline void *nv_carveout_vmap(unsigned long *pfns, unsigned int count,
+                                     pgprot_t prot)
+{
+    static atomic_t reports = ATOMIC_INIT(0);
+    unsigned int i, valid = 0, ram = 0;
+    bool contig = true;
+    const char *how = "none";
+    void *ptr = NULL;
+
+    for (i = 0; i < count; i++)
+    {
+        if (pfn_valid(pfns[i]))
+        {
+            valid++;
+            if (page_is_ram(pfns[i]))
+                ram++;
+        }
+        if (i > 0 && pfns[i] != pfns[i - 1] + 1)
+            contig = false;
+    }
+
+    if (valid == 0)
+    {
+        /* vmap_pfn() takes only pages without a struct page. */
+        ptr = vmap_pfn(pfns, count, prot);
+        how = "vmap_pfn";
+    }
+    else if (contig && ram == 0)
+    {
+        /* One physical range outside the linear map. */
+        ptr = (void __force *)__ioremap_prot(PFN_PHYS(pfns[0]),
+                                             (size_t)count << PAGE_SHIFT, prot);
+        how = "ioremap";
+    }
+
+    if (ptr == NULL || atomic_inc_return(&reports) <= 8)
+    {
+        pr_info("NVRM: carveout map %u pages %#llx..%#llx (valid %u, ram %u, %s) via %s: %s\n",
+                count, (unsigned long long)PFN_PHYS(pfns[0]),
+                (unsigned long long)PFN_PHYS(pfns[count - 1]), valid, ram,
+                contig ? "contiguous" : "scattered", how, ptr ? "ok" : "FAILED");
+    }
+    if (ptr == NULL)
+    {
+        for (i = 0; i < count && i < 16; i++)
+        {
+            pr_info("NVRM:   page %u: %#llx valid %d reserved %d ram %d\n", i,
+                    (unsigned long long)PFN_PHYS(pfns[i]), pfn_valid(pfns[i]),
+                    pfn_valid(pfns[i]) && PageReserved(pfn_to_page(pfns[i])),
+                    pfn_valid(pfns[i]) && page_is_ram(pfns[i]));
+        }
+    }
+
+    return ptr;
+}
+
+#endif /* __NV_CARVEOUT_MAP_H__ */
