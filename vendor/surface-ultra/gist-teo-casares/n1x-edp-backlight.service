[Unit]
Description=Surface Laptop Ultra internal panel brightness (eDP target luminance over NVIDIA AUX -> nvidia_0::lcd_backlight)
# Added by the [keyboard] agent 2026-10-18. Revert: systemctl disable --now n1x-edp-backlight; rm this file and /usr/local/sbin/n1x-edp-backlight; rm -r /var/lib/n1x-edp-backlight
After=systemd-modules-load.service

[Service]
ExecStartPre=/usr/bin/modprobe uleds
ExecStart=/usr/local/sbin/n1x-edp-backlight
Restart=always
RestartSec=5
StateDirectory=n1x-edp-backlight
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
NoNewPrivileges=yes

[Install]
WantedBy=multi-user.target
