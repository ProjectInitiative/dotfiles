[Unit]
Description=Surface Laptop Ultra keyboard backlight LED (HID 045E:0CC7 -> uleds surface::kbd_backlight)
# Added by the [keyboard] agent 2026-10-18. Revert: systemctl disable --now surface-kbd-backlight; rm this file and /usr/local/sbin/surface-kbd-backlight
ConditionPathExists=/sys/bus/hid/devices
After=systemd-udevd.service

[Service]
ExecStartPre=/usr/bin/modprobe uleds
ExecStart=/usr/local/sbin/surface-kbd-backlight
Restart=always
RestartSec=3
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
NoNewPrivileges=yes

[Install]
WantedBy=multi-user.target
