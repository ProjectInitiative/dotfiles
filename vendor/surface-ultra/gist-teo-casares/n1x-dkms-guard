#!/bin/sh
# Refuse to build a patched copy of an in-tree driver when the target kernel's
# stock driver no longer matches the source it was copied from.
# usage: n1x-dkms-guard <package> <kernelver> <module-file>=<stock srcversion> ...
pkg=$1; kver=$2; shift 2
state=/var/lib/n1x-dkms-guard
for pair in "$@"; do
	mod=${pair%%=*}; want=${pair#*=}
	f=$(find "/lib/modules/$kver/kernel" -name "$mod.ko*" 2>/dev/null | head -n1)
	[ -n "$f" ] || f=$(find /var/lib/dkms/*/original_module/"$kver" -name "$mod.ko*" 2>/dev/null | head -n1)
	have=$( [ -n "$f" ] && modinfo -F srcversion "$f" 2>/dev/null )
	if [ "$have" != "$want" ]; then
		msg="$pkg: NOT building for $kver: stock $mod srcversion is '${have:-missing}', patch was made against '$want'. Rebase the patch (see 0-README.md, chapter 9)."
		echo "$msg" >&2
		mkdir -p "$state" 2>/dev/null && echo "$msg" > "$state/$pkg-$kver.NEEDS-REBASE"
		exit 1
	fi
done
rm -f "$state/$pkg-$kver.NEEDS-REBASE" 2>/dev/null
exit 0
