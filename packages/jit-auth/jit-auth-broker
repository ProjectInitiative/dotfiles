#!/usr/bin/env python3
"""jit-auth-broker — in-memory session credential holder for jit-auth shells.

Two modes:

serve  Hold one config blob in memory (read once from --config-fd, never from
       argv or a file). Listen on a private Unix socket. On each client
       request, create a FRESH memfd with the config and pass it to the
       client over SCM_RIGHTS. Each invocation therefore gets its own
       anonymous, seekable, RAM-only file with an independent read offset —
       concurrent clients never consume each other's bytes.

       Lifecycle: exits when stdin reaches EOF (parent auth script died) or
       a client sends SHUTDOWN. No periodic polling, no daemon left behind.

client Connect to the broker socket, receive the memfd, make it inheritable,
       then exec the real command with <env-var>=/proc/self/fd/<fd>. The
       config is never written to a named file anywhere.

Security posture (documented in modules/home/security/bitwarden/README.md):
this is a session capability boundary, NOT a defense against hostile code
running as the same Unix UID (ptrace / /proc / injection all defeat it).
"""

import argparse
import os
import select
import socket
import struct
import sys

MAX_CONFIG_BYTES = 4 * 1024 * 1024


def die(msg: str) -> None:
    print(f"jit-auth-broker: {msg}", sys.stderr)
    sys.exit(1)


def ppid_of(pid: int) -> int:
    try:
        with open(f"/proc/{pid}/status") as f:
            for line in f:
                if line.startswith("PPid:"):
                    return int(line.split()[1])
    except OSError:
        pass
    return 0


def is_descendant(pid: int, root: int, max_hops: int = 128) -> bool:
    """True if pid is root or a process-tree descendant of root."""
    for _ in range(max_hops):
        if pid == root:
            return True
        if pid <= 1:
            return False
        pid = ppid_of(pid)
    return False


def peer_pid(conn: socket.socket) -> int:
    """Best-effort SO_PEERCRED; returns 0 when unavailable."""
    try:
        SO_PEERCRED = socket.SO_PEERCRED  # noqa: N806 (Linux-only constant)
    except AttributeError:
        return 0
    try:
        creds = conn.getsockopt(socket.SOL_SOCKET, SO_PEERCRED, 12)
        pid, _uid, _gid = struct.unpack("3i", creds)
        return pid
    except OSError:
        return 0


def make_config_memfd(config: bytes) -> int:
    """memfd_create: anonymous RAM-only file, never swaps to a named path."""
    try:
        fd = os.memfd_create("jit-auth-config", 0)
    except (AttributeError, OSError) as e:
        die(f"memfd_create failed: {e}")
    os.write(fd, config)
    os.lseek(fd, 0, os.SEEK_SET)
    return fd


def read_config_fd(fd: int) -> bytes:
    chunks = []
    total = 0
    while True:
        chunk = os.read(fd, 65536)
        if not chunk:
            break
        total += len(chunk)
        if total > MAX_CONFIG_BYTES:
            die("config larger than 4MiB limit")
        chunks.append(chunk)
    return b"".join(chunks)


def cmd_serve(args) -> None:
    config = read_config_fd(args.config_fd)

    session_dir = os.path.dirname(args.socket)
    try:
        os.chmod(session_dir, 0o700)
    except OSError:
        pass  # dir may already be 0700 via XDG_RUNTIME_DIR

    if os.path.exists(args.socket):
        os.unlink(args.socket)
    listener = socket.socket(socket.AF_UNIX, socket.SOCK_STREAM)
    listener.bind(args.socket)
    os.chmod(args.socket, 0o600)
    listener.listen(8)

    # Signal readiness only after the socket is bound, so the parent can
    # safely launch shells once this line is printed.
    print("ready", flush=True)

    while True:
        try:
            rlist, _, _ = select.select([sys.stdin, listener], [], [])
        except InterruptedError:
            continue
        if sys.stdin in rlist:
            # Lifecycle pipe closed: parent auth script is gone.
            break
        if listener not in rlist:
            continue
        try:
            conn, _ = listener.accept()
        except InterruptedError:
            continue
        with conn:
            peer = peer_pid(conn)
            # Ancestry check is a capability boundary against *accidental*
            # access from unrelated user processes, not a security wall.
            if args.root_pid > 0 and peer > 0 and not is_descendant(peer, args.root_pid):
                continue
            try:
                req = conn.recv(32).decode(errors="replace").strip()
            except OSError:
                continue
            if req == "SHUTDOWN":
                break
            if req != "GET":
                continue
            fd = make_config_memfd(config)
            try:
                conn.sendmsg(
                    [b"K"],
                    [
                        (
                            socket.SOL_SOCKET,
                            socket.SCM_RIGHTS,
                            struct.pack("i", fd),
                        )
                    ],
                )
            except OSError:
                pass
            finally:
                os.close(fd)  # the dup lives on in the client's fd table

    try:
        os.unlink(args.socket)
    except OSError:
        pass


def cmd_client(args) -> None:
    try:
        conn = socket.socket(socket.AF_UNIX, socket.SOCK_STREAM)
        conn.connect(args.socket)
    except OSError as e:
        die(f"cannot reach auth session socket: {e}")
    with conn:
        conn.sendall(b"GET\n")
        try:
            data, ancdata, _flags, _addr = conn.recvmsg(
                16, socket.CMSG_SPACE(struct.calcsize("i"))
            )
        except OSError as e:
            die(f"failed to receive credential: {e}")
    fd = None
    for _level, _ctype, cdata in ancdata:
        fd = struct.unpack("i", cdata)[0]
        break
    if fd is None:
        die("auth session did not provide a credential")
    try:
        os.set_inheritable(fd, True)  # survive execvpe below
    except OSError:
        die("failed to prepare credential descriptor")
    env = dict(os.environ)
    env[args.env] = f"/proc/self/fd/{fd}"
    try:
        os.execvpe(args.cmd[0], args.cmd, env)
    except OSError:
        die(f"cannot execute {args.cmd[0]}")


def main() -> None:
    parser = argparse.ArgumentParser(prog="jit-auth-broker", add_help=False)
    sub = parser.add_subparsers(dest="mode", required=True)

    p_serve = sub.add_parser("serve")
    p_serve.add_argument("--socket", required=True)
    p_serve.add_argument("--root-pid", type=int, default=0)
    p_serve.add_argument("--config-fd", type=int, default=3)

    p_client = sub.add_parser("client")
    p_client.add_argument("--socket", required=True)
    p_client.add_argument("--env", required=True)
    p_client.add_argument("cmd", nargs=argparse.REMAINDER)

    args = parser.parse_args()
    if args.mode == "client":
        # strip possible leading "--" from REMAINDER
        cmd = args.cmd
        if cmd and cmd[0] == "--":
            cmd = cmd[1:]
        if not cmd:
            die("client mode requires -- <command>")
        args.cmd = cmd
        cmd_client(args)
    else:
        cmd_serve(args)


if __name__ == "__main__":
    main()
