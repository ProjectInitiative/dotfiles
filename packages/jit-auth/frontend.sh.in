#!/usr/bin/env bash
# jit-auth frontend template (k8s-auth / rclone-auth).
# Placeholders (@...@) are substituted by the Nix derivation at build time.
# Holds only identifiers and store paths — never secret contents.
set -euo pipefail

export PATH="@bitwardenCli@/bin:$PATH"
export JIT_SESSION_NAME="@session_name@"
export JIT_BW_ITEM="@bw_item@"
export JIT_CMD_NAME="@cmd_name@"
export JIT_CONFIG_ENV="@config_env@"
export JIT_REAL_BIN="@real_bin@"
export JIT_BROKER="@out@/bin/jit-auth-broker"

exec "@out@/bin/jit-auth-run" "$@"
