#!/usr/bin/env bash
# jit-auth-run — generic authenticated-session shell used by k8s-auth and
# rclone-auth (parameters arrive via JIT_* environment variables set by the
# thin Nix-built frontends).
#
#   JIT_SESSION_NAME   short label (k8s, rclone) for messages/prompt
#   JIT_BW_ITEM        Bitwarden item (UUID or name) holding the raw config
#   JIT_CMD_NAME       wrapped command name (kubectl, rclone)
#   JIT_CONFIG_ENV     env var the real tool reads (KUBECONFIG, RCLONE_CONFIG)
#   JIT_REAL_BIN       absolute path to the real Nix-store binary (existence check)
#   JIT_WRAPPERS       space-separated "cmd:/abs/path" pairs to wrap via PATH
#   JIT_BROKER         path to jit-auth-broker
#
# Lifecycle: unlock Bitwarden once -> fetch config once -> hand it to a
# jit-auth-broker owning ONE session-lifetime mutable memfd -> spawn $SHELL
# with session PATH wrappers (kubectl, kubectx, kubens, k9s, rclone, sops) ->
# each wrapped invocation receives a descriptor to that SAME memfd over
# SCM_RIGHTS (independent per-client offsets), so kubectx/kubens mutations
# persist across commands while the config exists only in anonymous RAM.
# On exit: broker dies, memfd closes, session dir (socket/wrapper/fifo/vault
# cache) is removed. The config never exists as a named file; BW_SESSION
# never reaches the shell.
#
# SECURITY POSTURE: session scoping only — not a defense against hostile code
# already running as the same Unix UID (ptrace / /proc / injection defeat it).
# Purpose: no persistent credentials, no named credential files, no globally
# exported credentials, no accidental cross-session reuse. See
# modules/home/security/bitwarden/README.md.

set -euo pipefail

SESSION="${JIT_SESSION_NAME:?JIT_SESSION_NAME not set}"
BW_ITEM="${JIT_BW_ITEM:-}"
CMD_NAME="${JIT_CMD_NAME:?JIT_CMD_NAME not set}"
CONFIG_ENV="${JIT_CONFIG_ENV:?JIT_CONFIG_ENV not set}"
REAL_BIN="${JIT_REAL_BIN:?JIT_REAL_BIN not set}"
WRAPPERS="${JIT_WRAPPERS:?JIT_WRAPPERS not set}"
BROKER="${JIT_BROKER:?JIT_BROKER not set}"

msg() { printf '%s\n' "$*"; }
fail() { printf 'error: %s\n' "$*" >&2; exit 1; }

[ -n "$BW_ITEM" ] || fail "$SESSION auth is not configured: set the Bitwarden item in the module options"
[ -x "$REAL_BIN" ] || fail "wrapped binary not found: $REAL_BIN"
[ -d "${XDG_RUNTIME_DIR:-}" ] || fail "XDG_RUNTIME_DIR is not set"
command -v bw >/dev/null 2>&1 || fail "bitwarden CLI (bw) not found in PATH"

RUNTIME_BASE="$XDG_RUNTIME_DIR/jit-auth-$SESSION-$$"
SOCKET="$RUNTIME_BASE/broker.sock"
BIN_DIR="$RUNTIME_BASE/bin"
mkdir -p "$BIN_DIR"
chmod 700 "$RUNTIME_BASE"

# Bitwarden CLI state lives in RAM, never on disk: BITWARDENCLI_APPDATA_DIR
# (where bw keeps data.json — its encrypted vault cache) points at a FIXED
# tmpfs path under /run/user, shared by ALL jit-auth sessions and by any
# in-session manual `bw` (the env var is inherited by the session shell).
# The vault is downloaded ONCE PER BOOT: the first session after a reboot
# finds no cache and does a full `bw login` (2FA as configured); every later
# session just `bw unlock`s (master password only) against the warm cache.
# On reboot the tmpfs empties and the next session re-logins — no encrypted
# vault copies persist anywhere. The vault cache is shared; the SECRETS are
# not: each session's config still lives only in its broker memfd, exactly
# as before. (macOS has no /run/user; a hdiutil ram:// disk would be needed
# there. This fleet is Linux-only — see the module's platforms.)
export BITWARDENCLI_APPDATA_DIR="${BITWARDENCLI_APPDATA_DIR:-/run/user/$(id -u)/bitwarden}"
mkdir -p "$BITWARDENCLI_APPDATA_DIR" || fail "cannot create tmpfs vault cache dir (is /run/user/<uid> mounted?)"
chmod 700 "$BITWARDENCLI_APPDATA_DIR" 2>/dev/null || true

cleanup() {
  # Broker dies first so nothing can serve credentials afterwards (its memfd
  # — the only copy of the config — closes with it), then the session dir
  # (socket, wrappers, lifecycle fifo) goes away with the directory.
  if [ -n "${BROKER_PID:-}" ]; then
    kill "$BROKER_PID" 2>/dev/null || true
    wait "$BROKER_PID" 2>/dev/null || true
  fi
  rm -rf "$RUNTIME_BASE"
}
trap cleanup EXIT
trap 'cleanup; exit 130' INT
trap 'cleanup; exit 143' TERM

msg "🔐 Unlocking Bitwarden..."
# Reuse a valid unlocked session from the parent env if present; never pass
# BW_SESSION down into the auth shell (unset before exec).
BW_SESSION=""
if [ ! -f "$BITWARDENCLI_APPDATA_DIR/data.json" ]; then
  # First session since boot: the shared tmpfs cache is empty, so `bw unlock`
  # would have nothing to decrypt. Do the full login once — server auth with
  # 2FA as configured — which downloads data.json into the RAM cache and
  # yields a session key directly (--raw). Every later session this boot
  # takes the plain-unlock path below.
  msg "📥 No vault cache yet — full login (2FA may prompt)..."
  BW_SESSION="$(bw login --raw)" || { unset BW_SESSION; fail "bw login failed"; }
elif [ -n "${BW_SESSION:-}" ] && bw status --session "$BW_SESSION" 2>/dev/null | grep -q '"status" *: *1'; then
  : # parent already had an unlocked vault session; reuse it
else
  BW_SESSION="$(bw unlock --raw)" || { unset BW_SESSION; fail "failed to unlock Bitwarden"; }
fi
[ -n "$BW_SESSION" ] || { unset BW_SESSION; fail "failed to unlock Bitwarden"; }

# Vault freshness is once per boot by design: the shared tmpfs cache is
# downloaded by the first session's `bw login`, and later sessions reuse it
# as-is. Set JIT_AUTH_SYNC=1 to force a re-sync for this session (costs
# ~3-5s: one extra Node startup + network + full vault rewrite); secrets
# changed elsewhere mid-boot are not visible until then.
if [ "${JIT_AUTH_SYNC:-0}" = "1" ]; then
  bw sync --session "$BW_SESSION" >/dev/null 2>&1 || { unset BW_SESSION; fail "Bitwarden sync failed"; }
fi

# Single extraction point: adjust here if the secret lives in a custom field.
bw_fetch_config() { bw get notes "$BW_ITEM" --session "$BW_SESSION"; }

CONFIG="$(bw_fetch_config)" || { unset BW_SESSION; fail "failed to retrieve $SESSION configuration from Bitwarden"; }
[ -n "$CONFIG" ] || { unset BW_SESSION; fail "failed to retrieve $SESSION configuration from Bitwarden"; }
unset BW_SESSION  # the auth shell never sees the vault session key
# (No `bw lock` needed: without BW_SESSION the CLI holds no unlocked state.)

# Broker: config arrives on fd 3 (process-substitution pipe — the plaintext
# never exists as a named file). The broker materializes it into ONE
# session-lifetime mutable memfd and serves descriptors to it; the lifecycle
# fifo keeps the broker alive only while this script lives (EOF on exit
# stops it even if cleanup breaks).
LIFECYCLE="$RUNTIME_BASE/lifecycle"
mkfifo "$LIFECYCLE"
exec {LIFE_FD}<>"$LIFECYCLE"
"$BROKER" serve --socket "$SOCKET" --root-pid "$$" < "$LIFECYCLE" \
  >/dev/null \
  3< <(printf '%s' "$CONFIG") &
BROKER_PID=$!

for _ in $(seq 1 50); do
  [ -S "$SOCKET" ] && break
  kill -0 "$BROKER_PID" 2>/dev/null || fail "jit-auth helper failed to start"
  sleep 0.1
done
[ -S "$SOCKET" ] || fail "jit-auth helper failed to start"

# Session-local PATH wrappers: children resolve the tool via normal PATH
# lookup and land here; each invocation requests a descriptor to the SAME
# session memfd and execs the real Nix-store binary with
# <CONFIG_ENV>=/proc/self/fd/<fd>. Wrappers contain only store paths and the
# socket location — no secrets, no recursion (paths are absolute).
for entry in $WRAPPERS; do
  name="${entry%%:*}"
  bin="${entry#*:}"
  [ -x "$bin" ] || fail "wrapped binary not found: $bin"
  cat > "$BIN_DIR/$name" <<WRAPPER_EOF
#!/usr/bin/env bash
exec "$BROKER" client --socket "$SOCKET" --env "$CONFIG_ENV" -- "$bin" "\$@"
WRAPPER_EOF
  chmod 700 "$BIN_DIR/$name"
done

unset CONFIG  # drop our copy; the broker's memfd owns the only plaintext

export PATH="$BIN_DIR:$PATH"
export JIT_AUTH_SESSION="$SESSION"
# Best-effort prompt mark; if the user's zsh theme overrides PROMPT,
# JIT_AUTH_SESSION is the reliable hook for their own prompt config.
export PS1="[$SESSION] \${PS1}"
msg "🛡️  $SESSION auth session active"

set +e
"${SHELL:-/bin/sh}"
SHELL_STATUS=$?
set -e

msg "🔒 $SESSION auth session terminated (credential gone)"
exit "$SHELL_STATUS"
